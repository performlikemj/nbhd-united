FROM node:22-bookworm-slim

# Kept in sync with OPENCLAW_CURRENT_VERSION in
# apps/orchestrator/tool_policy.py — both at 2026.5.28 as of the fleet
# lock-in (PR #745 toolSearch config + #746 usage-reporter registerHook fix).
# tools.toolSearch is version-gated (>= 2026.5.28) in config_generator, so it
# applies to a tenant once their openclaw_version reaches 5.28 (new provisions
# + reactivations default to OPENCLAW_CURRENT_VERSION).
ARG OPENCLAW_VERSION=2026.5.28
# Pinned for Phase 1 BYO Anthropic CLI subscription. Binary is dormant
# until a tenant with byo_models_enabled=True connects via /settings/ai-provider.
ARG CLAUDE_CODE_VERSION=2.1.123

ENV NODE_ENV=production
# --dns-result-order=ipv4first: Azure Container Apps has unreliable IPv6 to
# external APIs. Node 22's autoSelectFamily=true tries IPv6 first, causing
# Telegram setWebhook to fail and trigger crash-loop auto-restarts.
# NOTE: --require for suppress-chmod-eperm.js is added AFTER the COPY step
# below (npm install reads NODE_OPTIONS and would fail if the file isn't
# present yet).
ENV NODE_OPTIONS="--max-old-space-size=512 --dns-result-order=ipv4first --no-network-family-autoselection"

# Older Debian releases bundle legacy aliases in tzdata and have no
# tzdata-legacy package, so install the split package only when available.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates bsdmainutils curl tzdata \
    && if apt-cache show tzdata-legacy >/dev/null 2>&1; then \
        apt-get install -y --no-install-recommends tzdata-legacy; \
    fi \
    && rm -rf /var/lib/apt/lists/*
# curl is used by entrypoint.sh to fire the container-started + BYO pre-warm
# hooks back at the Django control plane; without it those hooks silently
# no-op (the known "curl is MISSING from the image" bug).
# bsdmainutils provides `script(1)`, used by entrypoint.sh to fake a TTY
# around `openclaw models auth login` (its CLI handler hard-checks
# `process.stdin.isTTY` — see `auth-BQuNQ6PP.js:362`).

RUN npm install --global \
        "openclaw@${OPENCLAW_VERSION}" \
        "@openclaw/line@${OPENCLAW_VERSION}" \
        "@googleworkspace/cli" \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force
# OpenClaw 5.2 externalized the LINE channel plugin out of core. Pin
# @openclaw/line to the same OPENCLAW_VERSION so the manifest's
# minHostVersion check passes (see dist/manifest-registry-*.js).
# Telegram, memory-core, openrouter, anthropic remain bundled in core.

WORKDIR /opt/nbhd

COPY runtime/openclaw/plugins/nbhd-google-tools /opt/nbhd/plugins/nbhd-google-tools
COPY runtime/openclaw/plugins/nbhd-journal-tools /opt/nbhd/plugins/nbhd-journal-tools
COPY runtime/openclaw/plugins/nbhd-usage-reporter /opt/nbhd/plugins/nbhd-usage-reporter
COPY runtime/openclaw/plugins/nbhd-reddit-tools /opt/nbhd/plugins/nbhd-reddit-tools
COPY runtime/openclaw/plugins/nbhd-finance-tools /opt/nbhd/plugins/nbhd-finance-tools
COPY runtime/openclaw/plugins/nbhd-fuel-tools /opt/nbhd/plugins/nbhd-fuel-tools
COPY runtime/openclaw/plugins/nbhd-datebook-tools /opt/nbhd/plugins/nbhd-datebook-tools
COPY runtime/openclaw/plugins/nbhd-sautai-tools /opt/nbhd/plugins/nbhd-sautai-tools
COPY runtime/openclaw/plugins/nbhd-insights-tools /opt/nbhd/plugins/nbhd-insights-tools
COPY runtime/openclaw/plugins/nbhd-settings-tools /opt/nbhd/plugins/nbhd-settings-tools
COPY runtime/openclaw/plugins/nbhd-routing-context /opt/nbhd/plugins/nbhd-routing-context
COPY runtime/openclaw/plugins/nbhd-activity-stream /opt/nbhd/plugins/nbhd-activity-stream
COPY runtime/openclaw/plugins/nbhd-stream-progress /opt/nbhd/plugins/nbhd-stream-progress
COPY runtime/openclaw/plugins/nbhd-automation-tools /opt/nbhd/plugins/nbhd-automation-tools
COPY runtime/openclaw/plugins/nbhd-cron-enforcement /opt/nbhd/plugins/nbhd-cron-enforcement
COPY runtime/openclaw/plugins/nbhd-site-publishing /opt/nbhd/plugins/nbhd-site-publishing
# nbhd-document-keep is emitted into plugins.load.paths by config_generator
# whenever document_ingestion_enabled — omitting this COPY would hard-fail boot
# ("plugin path not found") exactly like the 2026-07-05 friends incident.
# Node-built-ins-only (no npm install).
COPY runtime/openclaw/plugins/nbhd-document-keep /opt/nbhd/plugins/nbhd-document-keep
COPY runtime/openclaw/plugins/nbhd-journal-shaping /opt/nbhd/plugins/nbhd-journal-shaping
# nbhd-friends-tools is emitted into plugins.load.paths by config_generator
# whenever friends_enabled — omitting this COPY made OpenClaw hard-fail boot
# with "plugin path not found: /opt/nbhd/plugins/nbhd-friends-tools", bricking
# every friends tenant's gateway (2026-07-05 incident). nbhd-agenda-tools had
# the same latent omission. Both are Node-built-ins-only (no npm install).
# The scripts/check_openclaw_plugin_packaging.py CI guard now fails the build
# if any shippable plugin is missing from this block.
COPY runtime/openclaw/plugins/nbhd-friends-tools /opt/nbhd/plugins/nbhd-friends-tools
COPY runtime/openclaw/plugins/nbhd-agenda-tools /opt/nbhd/plugins/nbhd-agenda-tools
# nbhd-doc-taint-guard is emitted into plugins.load.paths by config_generator
# UNCONDITIONALLY (docs/upload-security-threat-model.md P0-1/P0-2) — same
# "plugin path not found" boot-crash risk as the 2026-07-05 friends incident
# if this COPY were missing. Node-built-ins-only (no npm install).
COPY runtime/openclaw/plugins/nbhd-doc-taint-guard /opt/nbhd/plugins/nbhd-doc-taint-guard
COPY skills/gws-* /opt/nbhd/skills/
COPY agent-skills /opt/nbhd/agent-skills
COPY templates/openclaw /opt/nbhd/templates/openclaw
COPY runtime/openclaw/proxy.js /opt/nbhd/proxy.js
COPY runtime/openclaw/suppress-chmod-eperm.js /opt/nbhd/suppress-chmod-eperm.js
COPY runtime/openclaw/redact-stdout.js /opt/nbhd/redact-stdout.js
COPY runtime/openclaw/tool-logger.js /opt/nbhd/tool-logger.js
COPY runtime/openclaw/external-content-wrap.js /opt/nbhd/external-content-wrap.js
COPY runtime/openclaw/claude-with-token.sh /opt/nbhd/claude-with-token.sh
COPY runtime/openclaw/claude-settings.json /opt/nbhd/claude-settings.json
COPY runtime/openclaw/entrypoint.sh /usr/local/bin/nbhd-openclaw-entrypoint

# Vendor the site-publishing plugin's Azure SDK dependencies at build time.
# Unlike the other nbhd plugins (Node built-ins only), this one needs
# @azure/identity + @azure/storage-blob + @azure/cosmos — all pure JS, so
# they install without a compiler (there is no native toolchain in this image).
RUN npm install --prefix /opt/nbhd/plugins/nbhd-site-publishing --omit=dev --no-audit --no-fund \
    && npm cache clean --force

RUN chmod +x /usr/local/bin/nbhd-openclaw-entrypoint /opt/nbhd/claude-with-token.sh \
    && chown -R node:node /opt/nbhd /usr/local/bin/nbhd-openclaw-entrypoint

USER node

# --require: load shims before OpenClaw starts.
#   1. suppress-chmod-eperm.js — chmod EPERM/EACCES suppression. Two
#      layers: fs.chmodSync monkey-patch (handles 2026.5.7+ sync throws;
#      essential for cron firing) AND legacy plugin-SDK unhandledRejection
#      handler. See runtime/openclaw/suppress-chmod-eperm.js for full why.
#   2. redact-stdout.js — tenant-content redaction on stdout/stderr.
#      Required because openclaw@2026.5.7's gateway fast path skips
#      enableConsoleCapture(), so console writes hit the streams un-
#      redacted. Wraps process.{stdout,stderr}.write to mask known JSON
#      content shapes (raw_params, "message":"...") and drop non-
#      operational prose lines. See runtime/openclaw/redact-stdout.js.
ENV NODE_OPTIONS="${NODE_OPTIONS} --require /opt/nbhd/suppress-chmod-eperm.js --require /opt/nbhd/redact-stdout.js"

# Disable mDNS/bonjour — useless on Azure Container Apps (containers are
# accessed via FQDN, not local network discovery) and causes intermittent
# CIAO ANNOUNCEMENT CANCELLED crashes on startup.
ENV OPENCLAW_DISABLE_BONJOUR=1

ENV OPENCLAW_GOOGLE_PLUGIN_PATH=/opt/nbhd/plugins/nbhd-google-tools
ENV OPENCLAW_USAGE_PLUGIN_ID=nbhd-usage-reporter
ENV OPENCLAW_USAGE_REPORTER_PLUGIN_ID=
ENV OPENCLAW_JOURNAL_PLUGIN_ID=nbhd-journal-tools
ENV OPENCLAW_USAGE_REPORTER_PLUGIN_PATH=/opt/nbhd/plugins/nbhd-usage-reporter
ENV OPENCLAW_JOURNAL_PLUGIN_PATH=/opt/nbhd/plugins/nbhd-journal-tools
ENV OPENCLAW_AUTOMATION_PLUGIN_ID=nbhd-automation-tools
ENV OPENCLAW_AUTOMATION_PLUGIN_PATH=/opt/nbhd/plugins/nbhd-automation-tools
ENV OPENCLAW_CRON_ENFORCEMENT_PLUGIN_ID=nbhd-cron-enforcement
ENV OPENCLAW_CRON_ENFORCEMENT_PLUGIN_PATH=/opt/nbhd/plugins/nbhd-cron-enforcement

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/nbhd-openclaw-entrypoint"]
